# ---------------------------------------------------------------------------
# Renew — environment variables
# Copy this file to ".env" and fill in the values from your Supabase project.
# Find them in Supabase: Project Settings -> API.
#
# Only these two keys are needed. The compliance acceptance log and the product
# catalog both use the public "anon" key with row-level security, so no secret
# service_role key is required (and it must NEVER be placed in a Vite frontend,
# since anything with the VITE_ prefix ships to the browser).
#
# The app runs on bundled local data if these are left blank, so you can
# develop the frontend before wiring up Supabase.
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Your project's public anon/publishable key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Marketing analytics (optional). Each loads only if its ID is set — leave
# blank to disable. These are public client-side IDs (VITE_ prefix).
# ---------------------------------------------------------------------------
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_CLARITY_ID=

# ---------------------------------------------------------------------------
# Square payments (client-side — public, safe to expose). If the App ID and
# Location ID are set, checkout shows Square's card form; otherwise it falls
# back to pay-on-delivery. Use SANDBOX values while testing.
#   VITE_SQUARE_ENV: 'sandbox' (default) or 'production'
# ---------------------------------------------------------------------------
VITE_SQUARE_APP_ID=
VITE_SQUARE_LOCATION_ID=
VITE_SQUARE_ENV=sandbox

# ---------------------------------------------------------------------------
# Server-side keys — set these in NETLIFY environment variables, NOT here
# (no VITE_ prefix, never shipped to the browser). Listed for reference:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY   (orders / applications / inquiries)
#   RESEND_API_KEY, ORDER_FROM_EMAIL, ORDER_NOTIFY_EMAILS, PARTNER_FROM_EMAIL
#   META_PIXEL_ID, META_CAPI_TOKEN            (Meta Conversions API — Purchase)
#   OMNISEND_API_KEY                          (newsletter subscribe)
#   SQUARE_ACCESS_TOKEN, SQUARE_LOCATION_ID, SQUARE_ENV   (Square Payments API)
# ---------------------------------------------------------------------------
